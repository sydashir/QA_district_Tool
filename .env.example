# District Site Auditor — every environment variable the system reads.
#
#   cp .env.example .env && ${EDITOR:-nano} .env
#
# .env is gitignored. Nothing in here is read at import time, so a missing optional variable
# degrades a feature rather than breaking start-up — the notes below say which.
#
# Each entry was found by grepping the source, not from memory. File:line references are given so
# the next person can check rather than trust.


# =================================================================================================
# DATABASE  (server/db.py:13, server/jobs.py:33, migrations/env.py)
# =================================================================================================

# SQLAlchemy URL. MUST carry the +psycopg driver — the plain postgresql:// form makes SQLAlchemy
# reach for psycopg2, which is not installed. Alembic reads this same variable, so there is one
# definition of "where the database is" for the API, the worker and migrations.
# Under docker compose this is set by the compose file itself (host `db`), not from here.
DATABASE_URL=postgresql+psycopg://district:CHANGE_ME@127.0.0.1:55432/district

# Procrastinate takes a plain libpq DSN — same database, no SQLAlchemy driver prefix. It is a
# separate variable because the two libraries disagree about URL syntax, not because they should
# ever point at different databases. Keep them in sync.
PROCRASTINATE_DSN=postgresql://district:CHANGE_ME@127.0.0.1:55432/district

# Consumed by the postgres container in docker-compose.yml. Ignored by a non-Docker install, where
# the role is created by hand (see deploy/README.md).
POSTGRES_USER=district
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=district


# =================================================================================================
# EMAIL DIGEST  (server/mail.py)
# =================================================================================================

# Base URL of the dashboard, used to build the links inside a digest (mail.py:22). Set it to the
# public Cloudflare Access hostname — a link to localhost in somebody's inbox is a dead link.
APP_URL=https://auditor.example.com

# Envelope sender (mail.py:23). Must be a domain the SMTP provider is authorised to send for, or
# everything lands in spam.
MAIL_FROM=auditor@example.com

# Recipients, comma-separated (mail.py:24).
MAIL_TO=syed@example.com

# THE SWITCH THAT DECIDES WHETHER EMAIL IS REAL. With SMTP_HOST unset, mail.send() writes each
# message to reports/_outbox/ and returns False (mail.py:70-78) — the logic runs and is testable,
# nothing is delivered. Set it and digests actually go out.
# Note what is NOT configurable: a digest is only sent when a run found NEW ERRORs, failed, or was
# refused. Silence on a quiet night is the design, not a misconfiguration.
#SMTP_HOST=smtp.example.com
SMTP_PORT=587
# If SMTP_USER is set, mail.py starts TLS and logs in (mail.py:84-86). Leave both unset for an
# unauthenticated local relay.
#SMTP_USER=
#SMTP_PASSWORD=


# =================================================================================================
# THE OUT-OF-REPO ACF RULESET  (auditor/checks/placeholder.py:31)
# =================================================================================================

# Directory containing the GeoData Fetcher's geo_field_validator.py. The placeholder check
# importlib-loads extract_acf_tokens from it as the single source of truth for [acf field=...]
# parsing, and RAISES FileNotFoundError if it is absent. Exactly one file is needed; deploy/README
# has the copy step.
#
# TREAT THIS VALUE AS PERMANENT. auditor/checks_version.py:65 hashes the PATH STRING itself as a
# version component, on purpose — repointing the ruleset IS a rule change. Changing it invalidates
# every brand's resume cache and makes the next run report `rule_changed` across the board.
GEODATA_SERVICES_DIR=/opt/geodata-services

# Docker only, and NOT the same thing: where that directory lives on the HOST, for the bind mount.
# The host path may differ per machine; the container path above must not.
#GEODATA_HOST_DIR=/opt/geodata-services


# =================================================================================================
# WORDPRESS REST FALLBACK CREDENTIALS  (auditor/crawl.py:136, names from config/<brand>.toml)
# =================================================================================================
#
# OPTIONAL, and unset is a supported state: _wp_auth_header returns None and enumeration proceeds
# unauthenticated (crawl.py:131-140). They matter when a brand's sitemap is blocked or missing and
# the crawler has to fall back to /wp-json/wp/v2/pages on a site that requires auth.
#
# These are WordPress APPLICATION PASSWORDS, not account passwords. The variable names are not
# guessable — each is declared in that brand's config file, e.g. config/rr.toml:26.
#RR_WP_USER=
#RR_WP_PASS=
#GL_WP_USER=
#GL_WP_PASS=
#AH_WP_USER=
#AH_WP_PASS=
#AR_WP_USER=
#AR_WP_PASS=
#CAD_WP_USER=
#CAD_WP_PASS=
#COC_WP_USER=
#COC_WP_PASS=
#DBH_WP_USER=
#DBH_WP_PASS=
#MHD_WP_USER=
#MHD_WP_PASS=
#TDRC_WP_USER=
#TDRC_WP_PASS=


# =================================================================================================
# NIGHTLY TRIGGER  (deploy/nightly_enqueue.py)
# =================================================================================================

# Where the enqueue script finds the API. Loopback, because it runs on the same box and must not
# go out through Cloudflare Access.
AUDITOR_API_URL=http://127.0.0.1:8099

# Optional external watchdog (Healthchecks.io or equivalent). Unset, a night that silently did not
# happen is only discoverable by someone thinking to look at the dashboard. The script pings the
# URL on success and <url>/fail on failure.
#HEALTHCHECK_PING_URL=https://hc-ping.com/your-uuid-here


# =================================================================================================
# CHECK TOGGLES  (auditor/checks/spelling.py:51)
# =================================================================================================

# Dictionary spellcheck. OFF unless set to something other than "", "0", "false" or "False".
# LEAVE IT OFF. It is a documented negative result (ARCHITECTURE.md D10): 9% precision by distinct
# word, because rare single-brand pharmaceutical vocabulary is indistinguishable from a typo on
# this corpus. It is parked behind this flag, not deleted, so the measurement can be repeated.
#SPELLCHECK=


# =================================================================================================
# GOOGLE SHEETS EXPORT — READ THIS, IT IS NOT AN ENVIRONMENT VARIABLE
# =================================================================================================
#
# There is NO env var for the service-account key. The path is a hardcoded constant:
#
#     auditor/publish.py:102   CREDENTIALS = "/Users/ashir/Documents/workk/district/credentials/service-account.json"
#
# That is a developer's laptop path and it does not exist on a Linux VM, so `POST /api/export/sheet`
# returns 503 until it is dealt with. Two ways, both in deploy/README.md:
#   1. change that one line to /etc/auditor/service-account.json  (preferred — publish.py is NOT
#      hashed into checks_version, so editing it does not invalidate any resume cache), or
#   2. recreate the literal path on the box and drop the key there (no code change).
# The sheet id it writes to is likewise a constant (auditor/publish.py:101) and is the ONLY
# spreadsheet this tool may ever touch.

# Browser origins allowed to call the API. Comma-separated. Only needed when the SPA is served
# from a different origin than the API; under the Caddy same-origin layout in deploy/README.md CORS
# never engages and the default is fine.
#CORS_ORIGINS=https://audit.example.com
